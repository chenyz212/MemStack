{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemStack",
  "version": "0.4.1",
  "identifier": "com.memstack.desktop",
  "build": {
    "frontendDist": "../memory-web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../target/release/MemStack-MCP.exe": "MemStack-MCP.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
